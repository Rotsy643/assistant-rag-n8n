{
  "name": "2 - Assistant question-réponse",
  "nodes": [
    {
      "parameters": {
        "public": true,
        "options": {}
      },
      "webhookId": "b2000001-0000-4000-8000-000000000001",
      "id": "b2000001-0000-4000-8000-000000000002",
      "name": "Chat web",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "Tu es « Maki », l'assistant virtuel du restaurant Le Zébu Doré à Antananarivo.\n\nRègles obligatoires :\n1. Réponds uniquement avec les informations renvoyées par l'outil de recherche dans les documents. N'utilise jamais tes connaissances générales.\n2. Cite la source à la fin de ta réponse, entre parenthèses : (source : nom du document).\n3. Si l'information ne se trouve pas dans les documents, réponds uniquement : FALLBACK\n4. N'invente jamais un prix, un horaire, un plat ou une condition.\n5. Ton poli, chaleureux et concis : 2 à 4 phrases maximum.\n6. Réponds en français. Si la question est en anglais ou en malgache, réponds dans cette langue quand c'est possible, en respectant les règles 1 à 4."
        }
      },
      "id": "b2000001-0000-4000-8000-000000000003",
      "name": "Assistant IA",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [280, 0]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "llama-3.3-70b-versatile",
          "mode": "list"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "b2000001-0000-4000-8000-000000000004",
      "name": "Modèle Groq",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [180, 220],
      "credentials": {
        "groqApi": {
          "id": "REMPLACER_PAR_ID_CREDENTIAL",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "contextWindowLength": 10
      },
      "id": "b2000001-0000-4000-8000-000000000005",
      "name": "Mémoire de conversation",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [340, 220]
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolName": "recherche_documents",
        "toolDescription": "Recherche dans les documents officiels du restaurant Le Zébu Doré (menu, horaires, conditions de réservation, FAQ). Utilise cet outil pour toute question sur le restaurant.",
        "qdrantCollection": {
          "__rl": true,
          "value": "documents_entreprise",
          "mode": "list"
        },
        "options": {
          "topK": 4
        }
      },
      "id": "b2000001-0000-4000-8000-000000000006",
      "name": "Recherche dans les documents",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.1,
      "position": [500, 220]
    },
    {
      "parameters": {
        "model": "nomic-embed-text",
        "options": {}
      },
      "id": "b2000001-0000-4000-8000-000000000007",
      "name": "Embeddings Ollama",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOllama",
      "typeVersion": 1,
      "position": [660, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-fallback",
              "leftValue": "={{ $json.output }}",
              "rightValue": "FALLBACK",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000001-0000-4000-8000-000000000008",
      "name": "Question sans réponse ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [600, 0]
    },
    {
      "parameters": {
        "chatId": "=REMPLACER_CHAT_ID_PROPRIO",
        "text": "=❓ Question sans réponse détectée\nQuestion : {{ $('Assistant IA').item.json.chatInput }}\nHeure : {{ $now.format('dd/MM/yyyy HH:mm') }}",
        "additionalFields": {}
      },
      "id": "b2000001-0000-4000-8000-000000000009",
      "name": "Notifier le propriétaire",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [840, -100]
    }
  ],
